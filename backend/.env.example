# Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reloop?schema=public"

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL="http://localhost:5173"
TRUST_PROXY=1

# JWT Authentication (Minimum 32 characters in development and production)
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars-long"
JWT_EXPIRES_IN="7d"

# Cookie Configuration (COOKIE_SAME_SITE must be 'lax', 'strict', or 'none'; 'none' requires production HTTPS)
COOKIE_NAME="reloop_token"
COOKIE_MAX_AGE_DAYS=7
COOKIE_SAME_SITE="lax"

# Password Reset Configuration
RESET_TOKEN_TTL_MINUTES=60

# Admin Seed Account (ADMIN_PASSWORD is required for prisma/seed.js; no default fallback)
ADMIN_NAME="Platform Admin"
ADMIN_EMAIL="admin@reloop.local"
ADMIN_PASSWORD=
